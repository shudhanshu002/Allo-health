generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  stocks      Stock[]
  createdAt   DateTime @default(now())
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  stocks    Stock[]
  createdAt DateTime @default(now())
}

model Stock {
  productId   String
  warehouseId String
  quantity    Int      // Total physical units in the warehouse
  reserved    Int      @default(0) // Units currently locked in pending reservations
  
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, warehouseId]) // Composite primary key
}

model Reservation {
  id          String            @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
}